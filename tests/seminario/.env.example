# Ejemplo documental. El ejecutor lee variables del proceso, no carga .env automáticamente.
# El servidor y el puerto se generan automáticamente: no apuntar a producción.
SEMINARIO_BROWSER=chrome
# Opcional: ruta de un MP3 alternativo. Por defecto se usa Audio de prueba.mp3 de la raíz.
# SEMINARIO_AUDIO=C:/ruta/Audio de prueba.mp3
